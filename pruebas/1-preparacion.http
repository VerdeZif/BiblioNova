### 44 (espera 5 s) B pasó a Confirmada y C sigue Pendiente
< {%
const t = Date.now(); while (Date.now() - t < 5000) {}
%}
GET {{host}}/api/reservas?libroId={{libroR}}&page=0&size=50
Authorization: Bearer {{tokenStaff}}

> {%
client.test("B2 Confirmada y C2 Pendiente", function () {
  const b = response.body.contenido.find(x => String(x.reservaId) === String(client.global.get("rB2")));
  const c = response.body.contenido.find(x => String(x.reservaId) === String(client.global.get("rC2")));
  client.assert(b && b.estado === "Confirmada", "B estado " + (b ? b.estado : "no encontrada"));
  client.assert(c && c.estado === "Pendiente", "C estado " + (c ? c.estado : "no encontrada"));
});
%}


### =====================================================================
### PAUSA SQL  -  mira la salida (client.log) de ESTE request
### =====================================================================

### 99 Imprime los 2 UPDATE con los ids reales
GET {{host}}/api/auth/me
Authorization: Bearer {{tokenStaff}}

> {%
client.log("=== EJECUTA ESTO EN MySQL Y LUEGO CORRE 2-verificacion.http ===");
client.log("UPDATE prestamos SET fechaVencimiento = CURDATE() - INTERVAL 4 DAY WHERE prestamoId = " + client.global.get("prestamoM1") + ";");
client.log("UPDATE reservas SET fechaExpiracion = NOW() - INTERVAL 1 MINUTE WHERE reservaId = " + client.global.get("rB2") + ";");
%}
