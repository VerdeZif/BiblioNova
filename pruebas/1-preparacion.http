### 06 Recepción: 5 ejemplares del libro de multas
POST {{host}}/api/inventario/recepciones
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"tipoOrigen":"Donacion","donante":"Pruebas","lineas":[{"libroId":{{libroM}},"cantidad":5,"costoUnitario":0,"esVendible":false,"esPrestamo":true,"condicionFisica":"Bueno"}]}

> {%
client.test("5 ejemplares", function () {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(response.body.lineas[0].ejemplares.length === 5, "cantidad de ejemplares");
});
const e = response.body.lineas[0].ejemplares;
client.global.set("c1", e[0]); client.global.set("c2", e[1]); client.global.set("c3", e[2]);
%}

### 07 Recepción: 1 ejemplar del libro de reservas
POST {{host}}/api/inventario/recepciones
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"tipoOrigen":"Donacion","donante":"Pruebas","lineas":[{"libroId":{{libroR}},"cantidad":1,"costoUnitario":0,"esVendible":false,"esPrestamo":true,"condicionFisica":"Bueno"}]}

> {%
client.test("1 ejemplar", function () { client.assert(response.status === 201, "status " + response.status); });
client.global.set("codR", response.body.lineas[0].ejemplares[0]);
%}

