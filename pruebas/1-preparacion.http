client.global.set("libroM", response.body.libroId);
%}

### 05 Libro para RESERVAS (tendrá un solo ejemplar)
POST {{host}}/api/catalogo/libros
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"titulo":"Libro Reservas {{sfx}}","autorIds":[{{autorId}}],"precioVenta":10.00,"prestamoHabilitado":true,"ventaHabilitada":false}

