### 20 Prestar c1 al lector M (quedará vencido por SQL en la pausa)
POST {{host}}/api/prestamos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lectorId":{{lectorM}},"codigosEjemplar":["{{c1}}"]}

> {%
client.test("préstamo M1 creado", function () { client.assert(response.status === 201, "status " + response.status); });
client.global.set("prestamoM1", response.body.prestamoId);
%}


### =====================================================================
### RESERVAS - CICLO 1: A y B sobre el libro de un solo ejemplar
### =====================================================================

### 30 A reserva -> Confirmada con ejemplar y 48 h
POST {{host}}/api/reservas
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{"libroId":{{libroR}}}

> {%
client.test("A Confirmada", function () {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(response.body.estado === "Confirmada", "estado " + response.body.estado);
  client.assert(response.body.codigoEjemplar != null, "sin codigoEjemplar");
  client.assert(response.body.fechaExpiracion != null, "sin fechaExpiracion");
});
client.global.set("rA1", response.body.reservaId);
%}

### 31 B reserva el mismo libro -> Pendiente
POST {{host}}/api/reservas
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{"libroId":{{libroR}}}

> {%
client.test("B Pendiente", function () {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(response.body.estado === "Pendiente", "estado " + response.body.estado);
});
client.global.set("rB1", response.body.reservaId);
%}

### 32 A repite la reserva -> 409
POST {{host}}/api/reservas
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{"libroId":{{libroR}}}

> {%
client.test("A repetida 409", function () { client.assert(response.status === 409, "status " + response.status); });
%}

### 33 Personal presta el ejemplar reservado al lector B -> 409
POST {{host}}/api/prestamos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lectorId":{{lectorB}},"codigosEjemplar":["{{codR}}"]}

> {%
client.test("reservado para otro 409", function () { client.assert(response.status === 409, "status " + response.status); });
%}

### 34 Personal presta el ejemplar al lector A -> funciona
POST {{host}}/api/prestamos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lectorId":{{lectorA}},"codigosEjemplar":["{{codR}}"]}

> {%
client.test("préstamo a A 201", function () { client.assert(response.status === 201, "status " + response.status); });
client.global.set("prestamoA", response.body.prestamoId);
%}

### 35 La reserva de A pasó a Atendida
GET {{host}}/api/reservas?libroId={{libroR}}&page=0&size=50
Authorization: Bearer {{tokenStaff}}

> {%
client.test("rA1 Atendida", function () {
  const r = response.body.contenido.find(x => String(x.reservaId) === String(client.global.get("rA1")));
  client.assert(r && r.estado === "Atendida", "estado " + (r ? r.estado : "no encontrada"));
});
%}

### 36 Devolver el ejemplar (Bueno) -> dispara la cola
POST {{host}}/api/prestamos/{{prestamoA}}/devoluciones
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lineas":[{"codigoEjemplar":"{{codR}}","condicionRecibida":"Bueno"}]}

> {%
client.test("devolución 201", function () { client.assert(response.status === 201, "status " + response.status); });
%}

### 37 (espera 5 s) La reserva de B pasó sola a Confirmada
< {%
const t = Date.now(); while (Date.now() - t < 5000) {}
%}
GET {{host}}/api/reservas?libroId={{libroR}}&page=0&size=50
Authorization: Bearer {{tokenStaff}}

> {%
client.test("rB1 Confirmada", function () {
  const r = response.body.contenido.find(x => String(x.reservaId) === String(client.global.get("rB1")));
  client.assert(r && r.estado === "Confirmada", "estado " + (r ? r.estado : "no encontrada"));
});
%}

### 38 Limpieza: B cancela su reserva (ejemplar vuelve a Disponible)
POST {{host}}/api/reservas/{{rB1}}/cancelar
Authorization: Bearer {{tokenB}}

> {%
client.test("B cancela", function () {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.estado === "Cancelada", "estado " + response.body.estado);
});
%}


