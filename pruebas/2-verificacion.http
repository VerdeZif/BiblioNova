### 20 Devolver c2 Danado con observaciones
POST {{host}}/api/prestamos/{{prestamoD}}/devoluciones
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lineas":[{"codigoEjemplar":"{{c2}}","condicionRecibida":"Danado","observaciones":"Tapa rota en la devolución"}]}

> {%
client.test("daño requiere evaluación", function () {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(response.body.lineas[0].requiereEvaluacion === true, "requiereEvaluacion");
});
%}

### 21 Multa Danio en EnRevision con monto 0
GET {{host}}/api/prestamos/multas?lectorId={{lectorM}}&tipo=Danio&page=0&size=10
Authorization: Bearer {{tokenStaff}}

> {%
client.test("Danio EnRevision monto 0", function () {
  const m = response.body.contenido[0];
  client.assert(m.estado === "EnRevision", "estado " + m.estado);
  client.assert(m.monto === 0, "monto " + m.monto);
  client.global.set("multaD", m.multaId);
});
%}

### 22 Pagar una multa EnRevision -> 409
POST {{host}}/api/prestamos/multas/{{multaD}}/pagos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"metodoCodigo":"EFECTIVO_TIENDA","monto":1.00}

> {%
client.test("pago en revisión 409", function () { client.assert(response.status === 409, "status " + response.status); });
%}

### 23 Evaluar: 15.00 -> Pendiente
POST {{host}}/api/prestamos/multas/{{multaD}}/evaluacion
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"monto":15.00,"justificacion":"Reposición de tapa"}

> {%
client.test("evaluada Pendiente 15.00", function () {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.multa.estado === "Pendiente", "estado " + response.body.multa.estado);
  client.assert(response.body.multa.monto === 15, "monto " + response.body.multa.monto);
});
%}

