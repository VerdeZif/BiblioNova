### =====================================================================
### BIBLIONOVA - PRUEBAS 4A  |  FASE 2 de 2  (Run all requests in file)
### =====================================================================
### Requisitos: haber corrido 1-preparacion.http y ejecutado en MySQL los
### 2 UPDATE que imprimió el último request. Usa las variables guardadas
### por la fase 1 (tokens, ids, códigos), así que NO cierres el IDE entre
### fases. foto.jpg debe estar junto a este archivo.
### El último request espera 65 s (scheduler de vencimiento).
### =====================================================================

@host = http://localhost:8080
@staffUser = admin
@staffPass = AdminBiblio2026!

### 00 Re-login personal (por si el token expiró)
POST {{host}}/api/auth/login
Content-Type: application/json

{"usuario":"{{staffUser}}","contrasena":"{{staffPass}}"}

> {%
client.test("login personal", function () { client.assert(response.status === 200, "status " + response.status); });
client.global.set("tokenStaff", response.body.token);
%}

### 01 Re-login cliente A
POST {{host}}/api/auth/login
Content-Type: application/json

{"usuario":"cliA{{sfx}}","contrasena":"Clave12345"}

> {%
client.test("login A", function () { client.assert(response.status === 200, "status " + response.status); });
client.global.set("tokenA", response.body.token);
%}


### =====================================================================
### MULTAS 1: retraso
### =====================================================================

### 10 Devolver c1 (Bueno) con 4 días de retraso
POST {{host}}/api/prestamos/{{prestamoM1}}/devoluciones
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lineas":[{"codigoEjemplar":"{{c1}}","condicionRecibida":"Bueno"}]}

> {%
client.test("devolución con 4 días de retraso", function () {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(response.body.lineas[0].diasRetraso === 4, "diasRetraso " + response.body.lineas[0].diasRetraso + " (¿corriste el UPDATE de prestamos?)");
});
%}

### 11 Multa Retraso: S/ 4.00, diasRetraso 4, saldo 4.00
GET {{host}}/api/prestamos/multas?lectorId={{lectorM}}&soloConSaldo=true&page=0&size=10
Authorization: Bearer {{tokenStaff}}

> {%
client.test("multa Retraso 4.00", function () {
  const m = response.body.contenido[0];
  client.assert(m.tipoMulta === "Retraso", "tipo " + m.tipoMulta);
  client.assert(m.monto === 4, "monto " + m.monto);
  client.assert(m.diasRetraso === 4, "dias " + m.diasRetraso);
  client.assert(m.saldo === 4, "saldo " + m.saldo);
  client.global.set("multaR", m.multaId);
});
%}

### 12 Préstamo nuevo al lector M -> 409 (multas pendientes)
POST {{host}}/api/prestamos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lectorId":{{lectorM}},"codigosEjemplar":["{{c2}}"]}

> {%
client.test("bloqueado por multa 409", function () { client.assert(response.status === 409, "status " + response.status); });
%}

### 13 Pago 1.50 -> Parcial, saldo 2.50
POST {{host}}/api/prestamos/multas/{{multaR}}/pagos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"metodoCodigo":"EFECTIVO_TIENDA","monto":1.50}

> {%
client.test("Parcial saldo 2.50", function () {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.multa.estado === "Parcial", "estado " + response.body.multa.estado);
  client.assert(response.body.multa.saldo === 2.5, "saldo " + response.body.multa.saldo);
});
%}

### 14 Pago 3.00 -> 409 (excede el saldo)
POST {{host}}/api/prestamos/multas/{{multaR}}/pagos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"metodoCodigo":"EFECTIVO_TIENDA","monto":3.00}

> {%
client.test("excede saldo 409", function () { client.assert(response.status === 409, "status " + response.status); });
%}

### 15 Pago 2.50 -> Pagada
POST {{host}}/api/prestamos/multas/{{multaR}}/pagos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"metodoCodigo":"EFECTIVO_TIENDA","monto":2.50}

> {%
client.test("Pagada", function () {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.multa.estado === "Pagada", "estado " + response.body.multa.estado);
});
%}

### 16 El lector M vuelve a poder pedir libros (c2)
POST {{host}}/api/prestamos
Authorization: Bearer {{tokenStaff}}
Content-Type: application/json

{"lectorId":{{lectorM}},"codigosEjemplar":["{{c2}}"]}

> {%
client.test("préstamo desbloqueado 201", function () { client.assert(response.status === 201, "status " + response.status); });
client.global.set("prestamoD", response.body.prestamoId);
client.global.set("ejemplarD", response.body.ejemplares[0].ejemplarId);
client.global.set("detalleD", response.body.ejemplares[0].detallePrestamoId);
%}


