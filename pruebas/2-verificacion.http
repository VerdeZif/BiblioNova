### =====================================================================
### RESERVAS - vencimiento (el UPDATE de reservas ya se corrió)
### =====================================================================

### 50 (espera 65 s) B quedó Vencida y C pasó a Confirmada
< {%
const t = Date.now(); while (Date.now() - t < 65000) {}
%}
GET {{host}}/api/reservas?libroId={{libroR}}&page=0&size=50
Authorization: Bearer {{tokenStaff}}

> {%
client.test("B Vencida y C Confirmada", function () {
  const b = response.body.contenido.find(x => String(x.reservaId) === String(client.global.get("rB2")));
  const c = response.body.contenido.find(x => String(x.reservaId) === String(client.global.get("rC2")));
  client.assert(b && b.estado === "Vencida", "B estado " + (b ? b.estado : "no encontrada") + " (¿corriste el UPDATE de reservas? ¿@EnableScheduling?)");
  client.assert(c && c.estado === "Confirmada", "C estado " + (c ? c.estado : "no encontrada"));
});
%}
