### 30 Archivo falso (texto con nombre .jpg) -> 400
POST {{host}}/api/prestamos/evidencias?ejemplarId={{ejemplarD}}&tipo=Devolucion&detallePrestamoId={{detalleD}}&descripcion=archivo falso
Authorization: Bearer {{tokenStaff}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="archivo"; filename="falso.jpg"
Content-Type: image/jpeg

esto es texto plano, no es una imagen
--WebAppBoundary--

> {%
client.test("archivo falso 400", function () { client.assert(response.status === 400, "status " + response.status); });
%}

### 31 JPG real -> 201
POST {{host}}/api/prestamos/evidencias?ejemplarId={{ejemplarD}}&tipo=Devolucion&detallePrestamoId={{detalleD}}&descripcion=Tapa rota
Authorization: Bearer {{tokenStaff}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="archivo"; filename="foto.jpg"
Content-Type: image/jpeg

< ./foto.jpg
--WebAppBoundary--

> {%
client.test("evidencia subida", function () { client.assert(response.status === 201, "status " + response.status); });
client.global.set("evidenciaId", response.body.evidenciaId);
%}

### 32 Descargar la imagen
GET {{host}}/api/prestamos/evidencias/{{evidenciaId}}/archivo
Authorization: Bearer {{tokenStaff}}

> {%
client.test("imagen devuelta", function () {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.contentType.mimeType.startsWith("image/"), "content-type " + response.contentType.mimeType);
});
%}

